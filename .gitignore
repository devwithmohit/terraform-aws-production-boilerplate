# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (use .example files for version control)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE & Editor folders
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# OS generated files
ehthumbs.db
[Nn]es[Tt]opia.dat
